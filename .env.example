#######################################################################
# Monitor de citas DIAN — configuración
# Copia este archivo a .env y ajusta los valores.  NUNCA subas .env a Git.
#######################################################################

# ─── Portal ──────────────────────────────────────────────────────────
# El portal es una aplicación WebForms que necesita el parámetro
# ?recurso=CitasDIAN para arrancar. Sin él sólo se ve el splash de carga.
DIAN_URL=https://agendamiento.dian.gov.co/?recurso=CitasDIAN

# ─── Qué vigilar ─────────────────────────────────────────────────────
# Cada valor corresponde al texto visible en el portal.
# La comparación ignora mayúsculas, tildes y el punto final,
# así que "Devoluciones" y "Devoluciones." funcionan igual.
#
# El recorrido se detiene en el primer valor vacío: así puedes vigilar
# sólo hasta el "tipo de servicio" sin llegar a fecha y hora.

# Obligatorio — "Persona Natural" | "Persona Jurídica"
DIAN_TARGET_PERSON_TYPE=Persona Natural

# Obligatorio — "Videoatención" | "Presencial"
DIAN_TARGET_ATTENTION_TYPE=Videoatención

# Categoría: en el portal es "Seleccione el tipo de servicio".
# Videoatención → RUT y orientación TAC. | Conferencias o capacitaciones. |
#                 Devoluciones. | Autogestión servicios en línea con NAF. |
#                 Inconsistencias Grandes Contribuyentes. | Cobranzas. | Defensoría.
# Presencial    → RUT y orientación TAC | Aduanas | Cobranzas |
#                 Recaudo (Corrección inconsistencias) | Defensoría
DIAN_TARGET_SERVICE=Devoluciones

# Trámite (desplegable "Trámite"). Déjalo vacío para detenerse
# justo después del tipo de servicio.
DIAN_TARGET_PROCEDURE=

# Ciudad — ej. "Bogotá, D.C."  (sólo aplica si hay trámite)
DIAN_TARGET_CITY=

# Sede — ej. "Bogotá Avenida 68" (sólo aplica si hay ciudad)
DIAN_TARGET_OFFICE=

# Meses del calendario a revisar hacia adelante (1-12)
DIAN_SCAN_MONTHS=2

# Mensaje que el portal muestra cuando NO hay disponibilidad.
# Si aparece exactamente este texto → no hay cita.
# Cualquier otro mensaje se considera un cambio y genera alerta.
DIAN_NO_AVAILABILITY_MESSAGE=No se encontraron especialidades relacionadas según los filtros seleccionados.

# ─── Correo (Resend) — OPCIONAL ──────────────────────────────────────
# Déjalos vacíos para desactivar el correo y usar sólo Telegram.
# Ojo: Resend exige un dominio propio verificado; no se puede enviar
# desde una dirección de Hotmail o Gmail que no controles.
# El correo SÓLO se envía cuando hay disponibilidad, nunca en las
# ejecuciones rutinarias.
RESEND_API_KEY=
# Debe ser un dominio verificado en Resend, o onboarding@resend.dev para pruebas.
EMAIL_FROM=Monitor DIAN <alertas@tudominio.com>
# Varios destinatarios separados por coma
EMAIL_TO=correo1@gmail.com,correo2@hotmail.com

# ─── Telegram ────────────────────────────────────────────────────────
# Token que entrega @BotFather. Déjalo vacío para desactivar Telegram.
TELEGRAM_BOT_TOKEN=
# Varios chats separados por coma (usa @userinfobot para conocer tu id)
TELEGRAM_CHAT_IDS=

# Adjunta la captura de la pantalla final a cada mensaje de Telegram
TELEGRAM_SEND_SCREENSHOT=true

# Cada cuántas ejecuciones enviar un resumen aunque no haya novedad.
# Sirve para confirmar que el monitor sigue vivo sin llenarte el chat.
#   50 → con cron cada 5 min, un resumen cada ~4 horas (≈6 al día)
#    1 → un mensaje en cada ejecución (~288 al día)
#    0 → nunca; sólo avisa cuando hay cita
#
# Cuando SÍ hay cita el aviso llega siempre, sin esperar al resumen.
# IMPORTANTE: el contador se guarda en el estado. En Railway necesitas un
# volumen montado en /app/data; sin él el contador se reinicia en cada
# ejecución y el resumen nunca se enviaría (ver README).
HEARTBEAT_EVERY_RUNS=50

# ─── Comportamiento ──────────────────────────────────────────────────
# true en Railway; false en local para ver el navegador
HEADLESS=true
# true = recorre y muestra qué notificaría, pero NO envía nada
DRY_RUN=false
# Minutos mínimos entre alertas de la MISMA disponibilidad.
# Con NOTIFY_EVERY_RUN=true el mensaje se envía igual, pero se marca como
# "es la misma disponibilidad del aviso anterior" en lugar de sonar a novedad.
NOTIFICATION_COOLDOWN_MINUTES=60
# Captura + diagnóstico JSON cuando falla la navegación
SCREENSHOT_ON_ERROR=true
# Captura también en las ejecuciones correctas (útil al depurar)
SCREENSHOT_ALWAYS=false
SCREENSHOT_DIR=screenshots
# debug | info | warn | error
LOG_LEVEL=info

# ─── Tiempos y reintentos ────────────────────────────────────────────
NAV_TIMEOUT_MS=90000
STEP_TIMEOUT_MS=45000
MAX_ATTEMPTS=3

# ─── Persistencia del estado ─────────────────────────────────────────
# json   → archivo local (requiere Railway Volume para sobrevivir al reinicio)
# memory → sin persistencia (cada ejecución es nueva; puede repetir alertas)
STATE_BACKEND=json
STATE_FILE_PATH=data/state.json
